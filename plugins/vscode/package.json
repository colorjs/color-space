{
  "name": "color-space",
  "displayName": "Color Space",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "colorjs",
  "license": "CC0-1.0",
  "icon": "dist/icon.png",
  "homepage": "https://color-space.io/",
  "repository": { "type": "git", "url": "https://github.com/colorjs/color-space", "directory": "plugins/vscode" },
  "bugs": "https://github.com/colorjs/color-space/issues",
  "sponsor": { "url": "https://github.com/sponsors/colorjs" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Visualization", "Other"],
  "keywords": ["color", "color picker", "oklch", "css", "display p3", "swiftui", "flutter", "design tokens", "color space", "gamut"],
  "type": "module",
  "main": "./dist/extension.cjs",
  "l10n": "./l10n",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [{ "id": "colorSpace", "title": "%view.name%", "icon": "dist/locus.svg" }]
    },
    "views": {
      "colorSpace": [{ "type": "webview", "id": "colorSpace.picker", "name": "%view.name%", "icon": "dist/locus.svg" }]
    },
    "commands": [
      { "command": "colorSpace.pick", "title": "%command.pick%", "category": "Color Space" },
      { "command": "colorSpace.convert", "title": "%command.convert%", "category": "Color Space" }
    ],
    "configuration": {
      "title": "Color Space",
      "properties": {
        "colorSpace.gamut": {
          "type": "string",
          "enum": ["p3", "srgb"],
          "enumDescriptions": ["%gamut.p3%", "%gamut.srgb%"],
          "default": "p3",
          "markdownDescription": "%gamut.description%"
        },
        "colorSpace.shaders": {
          "type": "string",
          "enum": ["off", "srgb", "linear"],
          "enumDescriptions": ["%shaders.off%", "%shaders.srgb%", "%shaders.linear%"],
          "default": "off",
          "markdownDescription": "%shaders.description%"
        }
      }
    },
    "mcpServerDefinitionProviders": [{ "id": "colorSpace.mcp", "label": "Color Space" }]
  },
  "scripts": {
    "vscode:prepublish": "node build.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  }
}
